{
  "manifest_version": 3,
  "name": "Stream Chat Translator for Twitch",
  "short_name": "StreamChatTranslate",
  "description": "[100% FREE & UNLIMITED] Real-time Twitch chat translator. Read and write in any language natively and instantly without limits.",
  "version": "2.3.5",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Logo_extension.png",
      "48": "Logo_extension.png",
      "128": "Logo_extension.png"
    }
  },
  "icons": {
    "16": "Logo_extension.png",
    "48": "Logo_extension.png",
    "128": "Logo_extension.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}